{
    "name": "ai-chat-app",
    "version": "1.0.0",
    "description": "AI chat with Express.js, MongoDB (Mongoose), Ollama, and a static browser client",
    "type": "module",
    "main": "server.js",
    "engines": {
        "node": ">=24.11.0"
    },
    "scripts": {
        "dev": "node --watch server.js",
        "start": "node server.js",
        "lint": "eslint app tests",
        "test": "mocha"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "mongoose": "^9.6.2",
        "ollama": "^0.6.3",
        "pino": "^10.3.1",
        "prom-client": "^15.1.3",
        "uuid": "^14.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "chai": "^6.2.2",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "mocha": "^11.7.5",
        "supertest": "^7.0.0"
    },
    "mocha": {
        "spec": "tests/**/*.test.js",
        "timeout": 10000,
        "exit": true
    }
}
