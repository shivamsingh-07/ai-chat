{
  "annotations": { "list": [] },
  "description": "CPU, memory, and replica count for the Ollama model pods.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["ai-chat", "model"],
  "title": "AI Chat / LLM Overview",
  "uid": "ai-chat-model-pods",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running model pods",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "expr": "kube_deployment_status_replicas_available{namespace=\"chat-app\",deployment=\"ai-chat-model\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU % of limit",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"cpu\"})", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory % of limit",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}) / sum(kube_pod_container_resource_limits{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"memory\"})", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU by pod",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}[5m]))", "legendFormat": "{{pod}}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory by pod",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"})", "legendFormat": "{{pod}}", "refId": "A" }]
    }
  ]
}
