{
  "annotations": {
    "list": []
  },
  "description": "Average CPU and memory versus pod requests for the Ollama model pods. Thresholds match the HPA: 75% CPU and 50% memory.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["ai-chat", "model", "llm"],
  "title": "AI Chat / LLM Overview",
  "uid": "ai-chat-model-pods",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Model Pods",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"chat-app\",deployment=\"ai-chat-model\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg CPU / Request",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "avg(sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}[5m])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"cpu\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Memory / Request",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "avg(sum by (pod) (container_memory_working_set_bytes{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"memory\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU / Request by Pod",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}[5m])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"cpu\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "avg(sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}[5m])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"cpu\"}))",
          "legendFormat": "avg",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory / Request by Pod",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"memory\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "avg(sum by (pod) (container_memory_working_set_bytes{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\"}) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"chat-app\",pod=~\"ai-chat-model-.+\",container=\"ai-chat-model\",resource=\"memory\"}))",
          "legendFormat": "avg",
          "refId": "B"
        }
      ]
    }
  ]
}
